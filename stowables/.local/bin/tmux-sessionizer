#!/usr/bin/env bash

DIRS=(
    "$HOME/Projects"
    "$HOME/Projects/learn"
)

if [[ $# -eq 1 ]]; then
    SELECTED=$1
else
    SELECTED=$(
        find "${DIRS[@]}" -mindepth 1 -maxdepth 1 -type d |
        sort -u |
        fzf)
fi

[[ -n $SELECTED ]] || exit 0

if [[ -d $SELECTED ]]; then
    echo "tmux-sessionizer: not a directory: $selected" >&2
    exit 1
fi

SELECTED_NAME=$(basename "$SELECTED")
SELECTED_NAME=${SELECTED_NAME//./_}
SELECTED_NAME=${SELECTED_NAME//:/_}

if ! tmux has-session -t "$SELECTED_NAME" 2>/dev/null; then
    tmux new-session -d \
        -s "$SELECTED_NAME" \
        -c "$SELECTED"
fi

if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "$SELECTED_NAME"
else
    tmux attach-session -t "$SELECTED_NAME"
fi
